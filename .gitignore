# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment & secret files
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# API Keys, Service Account & Credentials JSON files
service-account*.json
google-credentials*.json
firebase-adminsdk*.json
credentials.json
secrets.json
*_key.json
*_secret.json
db-password*

# Keys & Certificates
*.pem
*.key
*.pkcs12
*.p12
*.pfx
*.asc

# Database dumps
*.sql
*.sqlite
*.dump

# Vercel & IDE
.vercel
.vscode/*
!.vscode/settings.json
.idea

# Typescript
*.tsbuildinfo
next-env.d.ts
